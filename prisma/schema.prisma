generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN_MANAGEMENT
  OFFICE_SCHEDULING
  SALES
  SENIOR_INSTALLER
  CREW_MOBILE
  READ_ONLY
}

enum JobType {
  RESIDENTIAL
  COMMERCIAL
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              Role     @default(READ_ONLY)
  isSuperUser       Boolean  @default(false)
  isActive          Boolean  @default(true)
  // Which top-level nav sections this user can see/use. Empty means
  // unrestricted (full access) — the safe default so existing accounts keep
  // working; new accounts get an explicit selection from the create-user form.
  // Super users always have full access regardless of this list.
  permissions       String[] @default([])
  avatarStorageKey  String?
  // True for every account until its first successful sign-in. An admin creates
  // the account with a temporary password; on first login the user is forced to
  // set their own password before they can do anything else (still followed by
  // the normal email 2FA step, same as every login after that).
  mustResetPassword Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions                  Session[]
  twoFactorCodes            TwoFactorCode[]
  pendingLogins             PendingLogin[]
  auditLogs                 AuditLog[]
  assignedJobs              Job[]                 @relation("AssignedUser")
  uploadedFiles             FileAsset[]
  notesAuthored             Note[]                @relation("NoteAuthor")
  notesAssigned             Note[]                @relation("NoteAssignee")
  timesheetEntries          TimesheetEntry[]
  purchaseOrders            PurchaseOrder[]
  remedialsRaised           RemedialItem[]        @relation("RemedialRaisedBy")
  remedialsAssigned         RemedialItem[]        @relation("RemedialAssignedTo")
  acceptances               Acceptance[]
  assignedAssets            Asset[]
  vehicleChecklistsAssigned VehicleChecklist[]    @relation("VehicleChecklistAssignee")
  vehicleChecklistsCreated  VehicleChecklist[]    @relation("VehicleChecklistCreatedBy")
  vehiclesDriven            Vehicle[]             @relation("VehicleDriver")
  vehicleIssuesRaised       VehicleIssue[]        @relation("VehicleIssueRaisedBy")
  assetIssuesRaised         AssetIssue[]          @relation("AssetIssueRaisedBy")
  assessmentsReceived       InstallerAssessment[] @relation("AssessmentReviewee")
  assessmentsGiven          InstallerAssessment[] @relation("AssessmentReviewer")
  safetyIncidentsReported   SafetyIncident[]      @relation("SafetyIncidentReportedBy")
  marketingAssetsUploaded   MarketingAsset[]
  emailTemplatesCreated     EmailTemplate[]
  leadsAssigned             Lead[]
}

// A short-lived marker created right after password verification, before the
// 2FA code is confirmed. The cookie holding its raw token proves "this browser
// just passed the password check for this user" without granting a session —
// createSession() is only ever called after verifyTwoFactorCode() succeeds.
model PendingLogin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
}

// Tracks every login attempt (success or failure), keyed on both the
// submitted email and the source IP, so lockouts can't be bypassed by
// switching IP or by spraying many accounts from one IP.
model LoginAttempt {
  id             String   @id @default(cuid())
  emailAttempted String
  ip             String
  success        Boolean
  createdAt      DateTime @default(now())

  @@index([emailAttempted, createdAt])
  @@index([ip, createdAt])
}

model TwoFactorCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs  Job[]
  leads Lead[]
}

model Lead {
  id           String    @id @default(cuid())
  reference    String    @unique
  title        String
  description  String?
  source       String?
  status       String    @default("New")
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  convertedAt  DateTime?
}

model Job {
  number         String    @id
  title          String
  description    String?
  address        String?
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type           JobType   @default(RESIDENTIAL)
  status         String    @default("New")
  priority       String?
  dueDate        DateTime?
  assignedUserId String?
  assignedUser   User?     @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  supplier       String?
  poNumber       String?
  phone          String?
  email          String?
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  files                FileAsset[]
  timesheetEntries     TimesheetEntry[]
  purchaseOrders       PurchaseOrder[]
  remedialItems        RemedialItem[]
  acceptances          Acceptance[]
  installerAssessments InstallerAssessment[]
  safetyIncidents      SafetyIncident[]
  costing              JobCosting?
  quotes               Quote[]
}

// Metadata row for a file stored in Cloudflare R2 — the actual bytes never
// touch our database or our server (client uploads/downloads via short-lived
// presigned URLs generated in src/lib/storage.ts), only this record does.
model FileAsset {
  id           String   @id @default(cuid())
  jobNumber    String
  job          Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  fileName     String
  fileType     String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([jobNumber, createdAt])
}

// A lightweight backlog: anyone signed in can leave a note (a bug, a request,
// a "this still needs building") and assign it to someone. Doubles as the
// running checklist of what's left to migrate off the prototype.
model Note {
  id           String    @id @default(cuid())
  text         String
  authorId     String
  author       User      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("NoteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       String    @default("Open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
}

model TimesheetEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobNumber    String
  job          Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  dateWorked   DateTime
  workType     String
  startTime    String
  finishTime   String
  breakMinutes Int      @default(0)
  totalHours   Float
  notes        String?
  status       String   @default("Submitted")
  createdAt    DateTime @default(now())

  @@index([jobNumber, dateWorked])
  @@index([userId, dateWorked])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  poNumber    String    @unique
  jobNumber   String
  job         Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  supplier    String
  description String?
  amount      Float
  status      String    @default("Ordered")
  orderedById String?
  orderedBy   User?     @relation(fields: [orderedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  receivedAt  DateTime?

  @@index([jobNumber, createdAt])
}

model RemedialItem {
  id           String    @id @default(cuid())
  jobNumber    String
  job          Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  issue        String
  priority     String    @default("Normal")
  status       String    @default("Open")
  raisedById   String?
  raisedBy     User?     @relation("RemedialRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?     @relation("RemedialAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([jobNumber, status])
}

model Acceptance {
  id          String   @id @default(cuid())
  jobNumber   String
  job         Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  acceptedBy  String
  signedAt    DateTime @default(now())
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([jobNumber, signedAt])
}

model Vehicle {
  id               String    @id @default(cuid())
  name             String    @unique
  rego             String?
  wofDueDate       DateTime?
  regoDueDate      DateTime?
  serviceDueDate   DateTime?
  assignedToUserId String?
  assignedToUser   User?     @relation("VehicleDriver", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  mechanicEmail    String?
  createdAt        DateTime  @default(now())

  assets     Asset[]
  checklists VehicleChecklist[]
  issues     VehicleIssue[]
}

// "Notify Issue" (a driver flags something wrong) and "Request Service"
// (a driver or manager asks for a booking) both live here as different
// `type` values, so the same list/resolve UI covers both.
model VehicleIssue {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String    @default("Issue")
  description String
  raisedById  String?
  raisedBy    User?     @relation("VehicleIssueRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  status      String    @default("Open")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([vehicleId, status])
}

// Emailed to the assigned person when created; a scheduled check (see
// src/app/api/cron/vehicle-checklists) emails management if still Pending
// past its due date.
model VehicleChecklist {
  id                 String    @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items              String
  assignedToId       String
  assignedTo         User      @relation("VehicleChecklistAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  dueDate            DateTime
  status             String    @default("Pending")
  responses          String?
  completedAt        DateTime?
  overdueAlertSentAt DateTime?
  createdById        String?
  createdBy          User?     @relation("VehicleChecklistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  @@index([status, dueDate])
}

// Assigned to exactly one of a person or a vehicle (never both) — enforced in
// the create action, not the schema, since Prisma has no cross-field check.
model Asset {
  id                  String    @id @default(cuid())
  name                String
  assetType           String    @default("Other")
  description         String?
  assignedToUserId    String?
  assignedToUser      User?     @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedToVehicleId String?
  assignedToVehicle   Vehicle?  @relation(fields: [assignedToVehicleId], references: [id], onDelete: SetNull)
  // Electrical test & tag due date — mainly relevant for assetType "Tools" (NZ AS/NZS 3760).
  testTagDueDate      DateTime?
  status              String    @default("Active")
  createdAt           DateTime  @default(now())

  issues AssetIssue[]
}

// "Needs repair" reports for tools/equipment — the Asset-side equivalent of VehicleIssue.
model AssetIssue {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  description String
  raisedById  String?
  raisedBy    User?     @relation("AssetIssueRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  status      String    @default("Open")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([assetId, status])
}

// Matches Jo's real "Competency and KPI 360 Review" / "Job Checklist –
// Installer Quality & Compliance" forms, at section level (each score is the
// 1-5 rating for that whole section, not each individual line item within
// it — the source docs list ~4-5 line items per section). Covers both the
// per-job assessment (jobNumber set) and the quarterly 360 review
// (jobNumber null, reviewPeriod set instead). isSelfAssessment marks ones
// the installer filled in about themselves rather than a supervisor/HR.
model InstallerAssessment {
  id                    String   @id @default(cuid())
  revieweeId            String
  reviewee              User     @relation("AssessmentReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerId            String
  reviewer              User     @relation("AssessmentReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  jobNumber             String?
  job                   Job?     @relation(fields: [jobNumber], references: [number], onDelete: SetNull)
  reviewPeriod          String?
  isSelfAssessment      Boolean  @default(false)
  coreInstallationScore Int?
  healthSafetyScore     Int?
  residentialScore      Int?
  commercialScore       Int?
  leadershipScore       Int?
  administrationScore   Int?
  overallResult         String?
  qualityScore          Int?
  keyWins               String?
  keyIssues             String?
  actionsRequired       String?
  createdAt             DateTime @default(now())

  @@index([revieweeId, createdAt])
}

// Basic incident/hazard register — not sourced from the prototype (it had no
// Health & Safety view), built fresh to cover the common NZ trades-business
// need: log incidents/near-misses/hazards, who reported them, what was done.
model SafetyIncident {
  id           String    @id @default(cuid())
  type         String    @default("Incident") // Incident / Near Miss / Hazard
  severity     String    @default("Low") // Low / Medium / High
  description  String
  jobNumber    String?
  job          Job?      @relation(fields: [jobNumber], references: [number], onDelete: SetNull)
  reportedById String
  reportedBy   User      @relation("SafetyIncidentReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  actionTaken  String?
  status       String    @default("Open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
}

// Single-row table (one Xero organisation per Ali-Frame instance) holding
// the OAuth2 tokens from the connected Xero org. Access tokens expire after
// 30 minutes — getValidXeroClient() in lib/xero.ts refreshes automatically
// using refreshToken and rewrites this row, so nothing else needs to know
// about expiry.
model XeroConnection {
  id           String   @id @default(cuid())
  tenantId     String
  tenantName   String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One row per unique customer imported from the real Job Tracking
// spreadsheet — a Client can have many Jobs; nothing about one Job's data
// (address/costing/status) is ever merged into another Job for the same
// Client, per Jo's explicit instruction.
model JobCosting {
  id                   String    @id @default(cuid())
  jobNumber            String    @unique
  job                  Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  quoteNumber          String?
  dateAccepted         DateTime?
  quotedTotal          Float?
  deposit              Float?
  scaffolding          String? // "Yes"/"No" on most rows, occasionally a $ figure — kept as text to avoid losing either
  materialsQuoted      Float?
  materialsActual      Float?
  rubbishQuoted        Float?
  rubbishActual        Float?
  installQuoted        Float?
  installActual        Float?
  labourHoursQuoted    Float?
  labourHoursCM        Float? // sheet's own column is just labelled "CM" — meaning not documented in the source file
  labourHoursActual    Float?
  marginQuoted         Float?
  marginOverheadAmount Float? // fixed 23% of Margin|Quoted, as a $ amount (not a %, despite the column sitting under "Margin")
  marginActual         Float?
  marginProfit         Float?
  marginPct            Float?
  remedialFlag         Boolean?
  remedialCE           String? // sheet's own column is just labelled "C/E" — meaning not documented in the source file
  remedialName         String?
  remedialSeniorName   String?
  remedialLabourHours  Float?
  remedialLabourCost   Float?
  remedialDamage       Float?
  remedialMaterial     Float?
  remedialCost         Float?
  remedialUpdatedCost  Float?
  remedialProfit       Float?
  remedialMarginPct    Float?
  photosDocumented     Boolean?
  qaDocumented         Boolean?
  hsDocumented         Boolean? // Commercial sheet only
  projectManager       String? // Commercial sheet only
  sssp                 String? // Commercial sheet only
  commercialNotes      String? // catch-all for Commercial-only fields with no first-class column of their own yet
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// One shared library for the new Marketing nav section — a file and/or link
// filed under one of four categories (branding guidelines, logo, social
// media, pending content), rather than four bespoke models for four
// still-loosely-defined tabs.
model MarketingAsset {
  id           String   @id @default(cuid())
  category     String // BRANDING / LOGO / SOCIAL_MEDIA / PENDING_CONTENT
  title        String
  description  String?
  storageKey   String?
  fileName     String?
  linkUrl      String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([category, createdAt])
}

// Reusable email wording (matches the prototype's Email Templates note: pick
// a template, auto-fill job/client details, choose a sender). This is the
// template library itself — actually sending from a job/quote/PO with a
// per-sender signature is a follow-up once general outbound email exists.
model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Imported from the standalone "Ali Frame Estimates" prototype (real customer
// enquiries extracted from Outlook emails) — Jo's own stated goal was to
// eventually merge this into the real JMS app rather than keep it separate.
model Estimate {
  id                   String    @id @default(cuid())
  clientName           String
  email                String?
  phone                String?
  address              String?
  category             String?
  joineryDescription   String?
  size                 String?
  estimatedCostText    String?
  estimatedCostLowNZD  Float?
  estimatedCostHighNZD Float?
  status               String    @default("Quoted")
  dateReceived         DateTime?
  notes                String?
  widthMM              Float?
  heightMM             Float?
  cladding             String?
  joineryType          String?
  pdfStorageKey        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Imported from the real Quotes export (excludes Declined quotes per Jo's
// instruction — those were dropped at import time, not just hidden).
// jobNumber links to Job.number when a matching Job exists in this app;
// jobReference keeps the raw text either way so nothing is lost if the Job
// hasn't been imported (or never will be).
model Quote {
  id              String    @id @default(cuid())
  quoteNumber     String    @unique
  customerName    String
  jobReference    String?
  jobNumber       String?
  job             Job?      @relation(fields: [jobNumber], references: [number], onDelete: SetNull)
  status          String    @default("Sent")
  total           Float?
  amountInvoiced  Float?
  amountRemaining Float?
  quoteDate       DateTime?
  dateSent        DateTime?
  expiryDate      DateTime?
  hasFiles        Boolean   @default(false)
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([jobNumber])
}
