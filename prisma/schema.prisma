generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN_MANAGEMENT
  OFFICE_SCHEDULING
  SALES
  SENIOR_INSTALLER
  CREW_MOBILE
  READ_ONLY
}

enum JobType {
  RESIDENTIAL
  COMMERCIAL
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              Role     @default(READ_ONLY)
  isSuperUser       Boolean  @default(false)
  isActive          Boolean  @default(true)
  // True for every account until its first successful sign-in. An admin creates
  // the account with a temporary password; on first login the user is forced to
  // set their own password before they can do anything else (still followed by
  // the normal email 2FA step, same as every login after that).
  mustResetPassword Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions       Session[]
  twoFactorCodes TwoFactorCode[]
  pendingLogins  PendingLogin[]
  auditLogs      AuditLog[]
  assignedJobs   Job[]           @relation("AssignedUser")
  uploadedFiles  FileAsset[]
  notesAuthored  Note[]          @relation("NoteAuthor")
  notesAssigned  Note[]          @relation("NoteAssignee")
  timesheetEntries TimesheetEntry[]
  purchaseOrders   PurchaseOrder[]
  remedialsRaised   RemedialItem[] @relation("RemedialRaisedBy")
  remedialsAssigned RemedialItem[] @relation("RemedialAssignedTo")
  acceptances       Acceptance[]
}

// A short-lived marker created right after password verification, before the
// 2FA code is confirmed. The cookie holding its raw token proves "this browser
// just passed the password check for this user" without granting a session —
// createSession() is only ever called after verifyTwoFactorCode() succeeds.
model PendingLogin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
}

// Tracks every login attempt (success or failure), keyed on both the
// submitted email and the source IP, so lockouts can't be bypassed by
// switching IP or by spraying many accounts from one IP.
model LoginAttempt {
  id             String   @id @default(cuid())
  emailAttempted String
  ip             String
  success        Boolean
  createdAt      DateTime @default(now())

  @@index([emailAttempted, createdAt])
  @@index([ip, createdAt])
}

model TwoFactorCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs  Job[]
  leads Lead[]
}

model Lead {
  id          String    @id @default(cuid())
  reference   String    @unique
  title       String
  description String?
  source      String?
  status      String    @default("New")
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  convertedAt DateTime?
}

model Job {
  number         String    @id
  title          String
  description    String?
  address        String?
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type           JobType   @default(RESIDENTIAL)
  status         String    @default("New")
  priority       String?
  dueDate        DateTime?
  assignedUserId String?
  assignedUser   User?     @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  supplier       String?
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  files            FileAsset[]
  timesheetEntries TimesheetEntry[]
  purchaseOrders   PurchaseOrder[]
  remedialItems    RemedialItem[]
  acceptances      Acceptance[]
}

// Metadata row for a file stored in Cloudflare R2 — the actual bytes never
// touch our database or our server (client uploads/downloads via short-lived
// presigned URLs generated in src/lib/storage.ts), only this record does.
model FileAsset {
  id           String   @id @default(cuid())
  jobNumber    String
  job          Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  fileName     String
  fileType     String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([jobNumber, createdAt])
}

// A lightweight backlog: anyone signed in can leave a note (a bug, a request,
// a "this still needs building") and assign it to someone. Doubles as the
// running checklist of what's left to migrate off the prototype.
model Note {
  id           String    @id @default(cuid())
  text         String
  authorId     String
  author       User      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("NoteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       String    @default("Open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
}

model TimesheetEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobNumber     String
  job           Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  dateWorked    DateTime
  workType      String
  startTime     String
  finishTime    String
  breakMinutes  Int      @default(0)
  totalHours    Float
  notes         String?
  status        String   @default("Submitted")
  createdAt     DateTime @default(now())

  @@index([jobNumber, dateWorked])
  @@index([userId, dateWorked])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  poNumber    String    @unique
  jobNumber   String
  job         Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  supplier    String
  description String?
  amount      Float
  status      String    @default("Ordered")
  orderedById String?
  orderedBy   User?     @relation(fields: [orderedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  receivedAt  DateTime?

  @@index([jobNumber, createdAt])
}

model RemedialItem {
  id           String    @id @default(cuid())
  jobNumber    String
  job          Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  issue        String
  priority     String    @default("Normal")
  status       String    @default("Open")
  raisedById   String?
  raisedBy     User?     @relation("RemedialRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?     @relation("RemedialAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([jobNumber, status])
}

model Acceptance {
  id          String   @id @default(cuid())
  jobNumber   String
  job         Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  acceptedBy  String
  signedAt    DateTime @default(now())
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([jobNumber, signedAt])
}
