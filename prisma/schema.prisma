generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN_MANAGEMENT
  OFFICE_SCHEDULING
  SALES
  SENIOR_INSTALLER
  INTERMEDIATE_INSTALLER
  JUNIOR_INSTALLER
  CREW_MOBILE
  CONTRACTOR
  READ_ONLY
}

enum JobType {
  RESIDENTIAL
  COMMERCIAL
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String?
  passwordHash      String
  role              Role     @default(READ_ONLY)
  isSuperUser       Boolean  @default(false)
  // Who may see employee pay. Deliberately NOT implied by super user — granted per person, directly in the database.
  canViewPay        Boolean  @default(false)
  isActive          Boolean  @default(true)
  // Which top-level nav sections this user can see/use. Empty means
  // unrestricted (full access) — the safe default so existing accounts keep
  // working; new accounts get an explicit selection from the create-user form.
  // Super users always have full access regardless of this list.
  permissions       String[] @default([])
  avatarStorageKey  String?
  // True for every account until its first successful sign-in. An admin creates
  // the account with a temporary password; on first login the user is forced to
  // set their own password before they can do anything else (still followed by
  // the normal email 2FA step, same as every login after that).
  mustResetPassword Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions                  Session[]
  twoFactorCodes            TwoFactorCode[]
  pendingLogins             PendingLogin[]
  auditLogs                 AuditLog[]
  assignedJobs              Job[]                 @relation("AssignedUser")
  uploadedFiles             FileAsset[]
  notesAuthored             Note[]                @relation("NoteAuthor")
  notesAssigned             Note[]                @relation("NoteAssignee")
  timesheetEntries          TimesheetEntry[]
  timeClock                 TimeClock?
  // Authenticator-app (TOTP) sign-in. The key is stored encrypted; totpLastStep stops a code being used twice.
  notifications             Notification[]
  totpSecretEnc             String?
  totpEnabledAt             DateTime?
  totpLastStep              Int?
  trustedDevices            TrustedDevice[]
  recoveryCodes             RecoveryCode[]
  purchaseOrders            PurchaseOrder[]
  remedialsRaised           RemedialItem[]        @relation("RemedialRaisedBy")
  remedialsAssigned         RemedialItem[]        @relation("RemedialAssignedTo")
  acceptances               Acceptance[]
  assignedAssets            Asset[]
  vehicleChecklistsAssigned VehicleChecklist[]    @relation("VehicleChecklistAssignee")
  vehicleChecklistsCreated  VehicleChecklist[]    @relation("VehicleChecklistCreatedBy")
  vehiclesDriven            Vehicle[]             @relation("VehicleDriver")
  vehicleIssuesRaised       VehicleIssue[]        @relation("VehicleIssueRaisedBy")
  assetIssuesRaised         AssetIssue[]          @relation("AssetIssueRaisedBy")
  assessmentsReceived       InstallerAssessment[] @relation("AssessmentReviewee")
  assessmentsGiven          InstallerAssessment[] @relation("AssessmentReviewer")
  safetyIncidentsReported   SafetyIncident[]      @relation("SafetyIncidentReportedBy")
  marketingAssetsUploaded   MarketingAsset[]
  emailTemplatesCreated     EmailTemplate[]
  leadsAssigned             Lead[]
  communicationGroups       CommunicationGroup[]  @relation("CommunicationGroupMembers")
  scheduledTasksAssigned    JobScheduledTask[]    @relation("JobScheduledTaskAssignees")
  scheduledTasksCreated     JobScheduledTask[]    @relation("JobScheduledTaskCreatedBy")
  leave                     StaffLeave[]          @relation("StaffLeavePeople")
  leaveCreated              StaffLeave[]          @relation("StaffLeaveCreatedBy")
  employeeDocuments         EmployeeDocument[]    @relation("EmployeeDocumentOwner")
  employeeDocumentsUploaded EmployeeDocument[]    @relation("EmployeeDocumentUploadedBy")
  jobQuoteInputsUpdated     JobQuoteInputs[]
  invites                   InviteToken[]         @relation("UserInvites")
  qaReportsCreated          QaReport[]            @relation("QaReportCreator")
  qaCheckSheetsCreated      QaCheckSheet[]        @relation("QaCheckSheetCreator")
  incidentReportsSubmitted  IncidentReport[]      @relation("IncidentReportSubmittedBy")
  hsCompetencies            HsCompetency[]        @relation("UserCompetency")
  employeeDetail            EmployeeDetail?       @relation("EmployeeDetail")
  reviewsAsEmployee         Review360[]           @relation("ReviewEmployee")
  reviewsAsAssessor         Review360[]           @relation("ReviewAssessor")
  preStartsCompleted        HsPreStart[]          @relation("PreStartsCompleted")
  jsasPrepared              HsJsa[]               @relation("JsasPrepared")
  inductions                HsInduction[]         @relation("Inductions")
}

// HR files (contracts, ID, certifications) — same R2-backed upload pipeline
// as job Files, just namespaced under employees/ instead of jobs/ and linked
// to a person instead of a job.
model EmployeeDocument {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("EmployeeDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  docType      String   @default("Other") // Contract / ID / Certification / Other
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?    @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// A short-lived marker created right after password verification, before the
// 2FA code is confirmed. The cookie holding its raw token proves "this browser
// just passed the password check for this user" without granting a session —
// createSession() is only ever called after verifyTwoFactorCode() succeeds.
model PendingLogin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
}

// Tracks every login attempt (success or failure), keyed on both the
// submitted email and the source IP, so lockouts can't be bypassed by
// switching IP or by spraying many accounts from one IP.
model LoginAttempt {
  id             String   @id @default(cuid())
  emailAttempted String
  ip             String
  success        Boolean
  createdAt      DateTime @default(now())

  @@index([emailAttempted, createdAt])
  @@index([ip, createdAt])
}

model TwoFactorCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs  Job[]
  leads Lead[]
}

model Lead {
  id           String    @id @default(cuid())
  reference    String    @unique
  title        String
  description  String?
  source       String?
  status       String    @default("New")
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  convertedAt  DateTime?
}

model Job {
  number         String    @id
  title          String
  description    String?
  address        String?
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type           JobType   @default(RESIDENTIAL)
  status         String    @default("New")
  priority       String?
  priceType      String?
  leadSource     String? // "How did they hear about us?"
  installDays    Float? // asked when the job is accepted; sets the length of its Calendar booking
  dueDate        DateTime?
  startDate      DateTime?
  assignedUserId String?
  assignedUser   User?     @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  supplier       String?
  poNumber       String?
  phone          String?
  email          String?
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  files                FileAsset[]
  timesheetEntries     TimesheetEntry[]
  timeClocks           TimeClock[]
  purchaseOrders       PurchaseOrder[]
  remedialItems        RemedialItem[]
  acceptances          Acceptance[]
  installerAssessments InstallerAssessment[]
  safetyIncidents      SafetyIncident[]
  costing              JobCosting?
  quotes               Quote[]
  scheduledTasks       JobScheduledTask[]
  notes                Note[]
  quoteInputs          JobQuoteInputs?
  preStarts            HsPreStart[]          @relation("JobPreStarts")
  jsas                 HsJsa[]               @relation("JobJsas")
  sssp                 HsSssp?               @relation("JobSssp")
  checkMeasurePack     CheckMeasurePack?
  qaReports            QaReport[]
  qaCheckSheets        QaCheckSheet[]
}

// Metadata row for a file stored in Cloudflare R2 — the actual bytes never
// touch our database or our server (client uploads/downloads via short-lived
// presigned URLs generated in src/lib/storage.ts), only this record does.
model FileAsset {
  id           String            @id @default(cuid())
  jobNumber    String
  job          Job               @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  fileName     String
  fileType     String
  storageKey   String            @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  // Set when the file is attached to a specific booking (plans, instructions, etc.).
  bookingId    String?
  booking      JobScheduledTask? @relation("BookingFiles", fields: [bookingId], references: [id], onDelete: SetNull)
  qaPhotos     QaReportPhoto[]

  @@index([jobNumber, createdAt])
}

// A lightweight backlog: anyone signed in can leave a note (a bug, a request,
// a "this still needs building") and assign it to someone. Doubles as the
// running checklist of what's left to migrate off the prototype.
model Note {
  id           String    @id @default(cuid())
  text         String
  authorId     String
  author       User      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("NoteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       String    @default("Open")
  // Optional link to a job — lets a note live on that job's Notes tab
  // instead of (or as well as) the general Notes page.
  jobNumber    String?
  job          Job?      @relation(fields: [jobNumber], references: [number], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  attachments  NoteAttachment[]

  @@index([status, createdAt])
  @@index([jobNumber, createdAt])
}

// An in-app alert for one person (e.g. the office added a note to a job they're booked on). Shows on the bell + My Tasks.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  href      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt])
}

// A browser the person chose to "remember" for 30 days — it skips the sign-in code (never the password).
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  label      String   @default("Device")
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

// One-time codes for getting in if the authenticator app is lost. Stored hashed.
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

// A running work clock — one per person. Stopping it turns it into a TimesheetEntry.
model TimeClock {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobNumber String
  job       Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  workType  String   @default("Install")
  startedAt DateTime @default(now())
}

model TimesheetEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobNumber    String
  job          Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  dateWorked   DateTime
  workType     String
  startTime    String
  finishTime   String
  breakMinutes Int      @default(0)
  totalHours   Float
  notes        String?
  status       String   @default("Submitted")
  createdAt    DateTime @default(now())

  @@index([jobNumber, dateWorked])
  @@index([userId, dateWorked])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  poNumber    String    @unique
  jobNumber   String
  job         Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  supplier    String
  description String?
  amount      Float
  status      String    @default("Ordered")
  orderedById String?
  orderedBy   User?     @relation(fields: [orderedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  receivedAt  DateTime?

  @@index([jobNumber, createdAt])
}

model RemedialItem {
  id           String    @id @default(cuid())
  jobNumber    String
  job          Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  issue        String
  priority     String    @default("Normal")
  status       String    @default("Open")
  raisedById   String?
  raisedBy     User?     @relation("RemedialRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?     @relation("RemedialAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([jobNumber, status])
}

model Acceptance {
  id              String    @id @default(cuid())
  jobNumber       String
  job             Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  acceptedBy      String
  signedAt        DateTime  @default(now())
  notes           String?
  // Deposit / payment: once the quote is accepted AND this is paid, Tanya is told to book the check measure.
  depositPaidAt   DateTime?
  depositAmount   Float?
  tanyaNotifiedAt DateTime?
  createdById     String?
  createdBy       User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([jobNumber, signedAt])
}

model Vehicle {
  id                    String    @id @default(cuid())
  name                  String    @unique
  rego                  String?
  wofDueDate            DateTime?
  regoDueDate           DateTime?
  serviceDueDate        DateTime?
  assignedToUserId      String?
  assignedToUser        User?     @relation("VehicleDriver", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  mechanicEmail         String?
  // RUC (Road User Charges) tracking — seeded from a manual EROAD screenshot
  // (2026-09-26) until a real EROAD API connection exists (needs Jo's EROAD
  // account manager to issue API access; see src/app/(app)/sync/eroad).
  rucType               String? // "D-2" / "D-3" licence type
  rucOdometerKm         Int?
  rucStartDistKm        Int?
  rucEndDistKm          Int?
  rucRemainingKm        Int?
  rucUpdatedAt          DateTime?
  // Fleet/insurance details, imported from Jo's real asset register
  // (2026-09-30).
  vin                   String?
  insuranceCompany      String?
  insurancePolicyNumber String?
  preferredWorkshop     String?
  fuelCardNumber        String?
  vehicleNotes          String? // e.g. EROAD unit serial, roof racks, towbar
  currentOdometerKm     Int?
  nextServiceDueKm      Int?
  lastServiceDate       DateTime?
  createdAt             DateTime  @default(now())

  assets             Asset[]
  checklists         VehicleChecklist[]
  issues             VehicleIssue[]
  maintenanceRecords VehicleMaintenanceRecord[]
}

// Historical maintenance log, imported from Jo's "Asset Maintainence List"
// spreadsheet (one sheet per rego, 2026-09-26) — free-text fields kept as
// close to the source as possible rather than force-fit into structured data.
model VehicleMaintenanceRecord {
  id             String    @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  checklistDate  DateTime?
  completedBy    String?
  wofDate        String? // kept as text — source dates are inconsistently formatted, some rows aren't dates at all (e.g. "Service")
  kms            String?
  comments       String?
  actions        String?
  estimatedValue Float?
  createdAt      DateTime  @default(now())

  @@index([vehicleId, checklistDate])
}

// "Notify Issue" (a driver flags something wrong) and "Request Service"
// (a driver or manager asks for a booking) both live here as different
// `type` values, so the same list/resolve UI covers both.
model VehicleIssue {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String    @default("Issue")
  description String
  raisedById  String?
  raisedBy    User?     @relation("VehicleIssueRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  status      String    @default("Open")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([vehicleId, status])
}

// Emailed to the assigned person when created; a scheduled check (see
// src/app/api/cron/vehicle-checklists) emails management if still Pending
// past its due date.
model VehicleChecklist {
  id                 String    @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items              String
  template           String    @default("basic") // "basic" (free-text) | "monthly" (structured 26-point check)
  assignedToId       String
  assignedTo         User      @relation("VehicleChecklistAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  dueDate            DateTime
  status             String    @default("Pending")
  responses          String?
  completedAt        DateTime?
  overdueAlertSentAt DateTime?
  createdById        String?
  createdBy          User?     @relation("VehicleChecklistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  @@index([status, dueDate])
}

// Assigned to exactly one of a person or a vehicle (never both) — enforced in
// the create action, not the schema, since Prisma has no cross-field check.
model Asset {
  id                  String    @id @default(cuid())
  name                String
  assetType           String    @default("Other")
  description         String?
  assignedToUserId    String?
  assignedToUser      User?     @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedToVehicleId String?
  assignedToVehicle   Vehicle?  @relation(fields: [assignedToVehicleId], references: [id], onDelete: SetNull)
  // Electrical test & tag due date — mainly relevant for assetType "Tools" (NZ AS/NZS 3760).
  testTagDueDate      DateTime?
  serialNumber        String?
  estimatedValue      Float?
  assetCode           String? // register code, e.g. AF-GTU764-001
  purchaseDate        DateTime?
  receiptNote         String? // purchase reference / where the receipt is kept — not a file upload (yet)
  status              String    @default("Active")
  createdAt           DateTime  @default(now())

  issues AssetIssue[]
}

// "Needs repair" reports for tools/equipment — the Asset-side equivalent of VehicleIssue.
model AssetIssue {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  description String
  raisedById  String?
  raisedBy    User?     @relation("AssetIssueRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  status      String    @default("Open")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([assetId, status])
}

// Matches Jo's real "Competency and KPI 360 Review" / "Job Checklist –
// Installer Quality & Compliance" forms, at section level (each score is the
// 1-5 rating for that whole section, not each individual line item within
// it — the source docs list ~4-5 line items per section). Covers both the
// per-job assessment (jobNumber set) and the quarterly 360 review
// (jobNumber null, reviewPeriod set instead). isSelfAssessment marks ones
// the installer filled in about themselves rather than a supervisor/HR.
model InstallerAssessment {
  id                    String   @id @default(cuid())
  revieweeId            String
  reviewee              User     @relation("AssessmentReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerId            String
  reviewer              User     @relation("AssessmentReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  jobNumber             String?
  job                   Job?     @relation(fields: [jobNumber], references: [number], onDelete: SetNull)
  reviewPeriod          String?
  isSelfAssessment      Boolean  @default(false)
  coreInstallationScore Int?
  healthSafetyScore     Int?
  residentialScore      Int?
  commercialScore       Int?
  leadershipScore       Int?
  administrationScore   Int?
  overallResult         String?
  qualityScore          Int?
  keyWins               String?
  keyIssues             String?
  actionsRequired       String?
  createdAt             DateTime @default(now())

  @@index([revieweeId, createdAt])
}

// Basic incident/hazard register — not sourced from the prototype (it had no
// Health & Safety view), built fresh to cover the common NZ trades-business
// need: log incidents/near-misses/hazards, who reported them, what was done.
model SafetyIncident {
  id           String    @id @default(cuid())
  type         String    @default("Incident") // Incident / Near Miss / Hazard
  severity     String    @default("Low") // Low / Medium / High
  description  String
  jobNumber    String?
  job          Job?      @relation(fields: [jobNumber], references: [number], onDelete: SetNull)
  reportedById String
  reportedBy   User      @relation("SafetyIncidentReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  actionTaken  String?
  status       String    @default("Open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
}

// Single-row table (one Xero organisation per Ali-Frame instance) holding
// the OAuth2 tokens from the connected Xero org. Access tokens expire after
// 30 minutes — getValidXeroClient() in lib/xero.ts refreshes automatically
// using refreshToken and rewrites this row, so nothing else needs to know
// about expiry.
model XeroConnection {
  id           String   @id @default(cuid())
  tenantId     String
  tenantName   String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One row per unique customer imported from the real Job Tracking
// spreadsheet — a Client can have many Jobs; nothing about one Job's data
// (address/costing/status) is ever merged into another Job for the same
// Client, per Jo's explicit instruction.
model JobCosting {
  id                   String    @id @default(cuid())
  jobNumber            String    @unique
  job                  Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  quoteNumber          String?
  dateAccepted         DateTime?
  quotedTotal          Float?
  deposit              Float?
  scaffolding          String? // "Yes"/"No" on most rows, occasionally a $ figure — kept as text to avoid losing either
  materialsQuoted      Float?
  materialsActual      Float?
  rubbishQuoted        Float?
  rubbishActual        Float?
  installQuoted        Float?
  installActual        Float?
  labourHoursQuoted    Float?
  labourHoursCM        Float? // sheet's own column is just labelled "CM" — meaning not documented in the source file
  labourHoursActual    Float?
  marginQuoted         Float?
  marginOverheadAmount Float? // fixed 23% of Margin|Quoted, as a $ amount (not a %, despite the column sitting under "Margin")
  marginActual         Float?
  marginProfit         Float?
  marginPct            Float?
  remedialFlag         Boolean?
  remedialCE           String? // sheet's own column is just labelled "C/E" — meaning not documented in the source file
  remedialName         String?
  remedialSeniorName   String?
  remedialLabourHours  Float?
  remedialLabourCost   Float?
  remedialDamage       Float?
  remedialMaterial     Float?
  remedialCost         Float?
  remedialUpdatedCost  Float?
  remedialProfit       Float?
  remedialMarginPct    Float?
  photosDocumented     Boolean?
  qaDocumented         Boolean?
  hsDocumented         Boolean? // Commercial sheet only
  projectManager       String? // Commercial sheet only
  sssp                 String? // Commercial sheet only
  commercialNotes      String? // catch-all for Commercial-only fields with no first-class column of their own yet
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// One shared library for the new Marketing nav section — a file and/or link
// filed under one of four categories (branding guidelines, logo, social
// media, pending content), rather than four bespoke models for four
// still-loosely-defined tabs.
model MarketingAsset {
  id           String   @id @default(cuid())
  category     String // BRANDING / LOGO / SOCIAL_MEDIA / PENDING_CONTENT
  title        String
  description  String?
  storageKey   String?
  fileName     String?
  linkUrl      String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([category, createdAt])
}

// Reusable email wording (matches the prototype's Email Templates note: pick
// a template, auto-fill job/client details, choose a sender). This is the
// template library itself — actually sending from a job/quote/PO with a
// per-sender signature is a follow-up once general outbound email exists.
model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Imported from the standalone "Ali Frame Estimates" prototype (real customer
// enquiries extracted from Outlook emails) — Jo's own stated goal was to
// eventually merge this into the real JMS app rather than keep it separate.
model Estimate {
  id                   String    @id @default(cuid())
  clientName           String
  email                String?
  phone                String?
  address              String?
  category             String?
  joineryDescription   String?
  size                 String?
  estimatedCostText    String?
  estimatedCostLowNZD  Float?
  estimatedCostHighNZD Float?
  status               String    @default("Quoted")
  dateReceived         DateTime?
  notes                String?
  widthMM              Float?
  heightMM             Float?
  cladding             String?
  joineryType          String?
  pdfStorageKey        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Imported from the real Quotes export (excludes Declined quotes per Jo's
// instruction — those were dropped at import time, not just hidden).
// jobNumber links to Job.number when a matching Job exists in this app;
// jobReference keeps the raw text either way so nothing is lost if the Job
// hasn't been imported (or never will be).
model Quote {
  id              String    @id @default(cuid())
  quoteNumber     String    @unique
  customerName    String
  jobReference    String?
  jobNumber       String?
  job             Job?      @relation(fields: [jobNumber], references: [number], onDelete: SetNull)
  status          String    @default("Sent")
  total           Float?
  amountInvoiced  Float?
  amountRemaining Float?
  quoteDate       DateTime?
  dateSent        DateTime?
  expiryDate      DateTime?
  hasFiles        Boolean   @default(false)
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([jobNumber])
}

// Raw pricing inputs captured once (in Prepare Price) and reused for Send
// Quote, rather than asking Sales to type the same supplier price/margin/
// install figures twice. Send Quote applies its own formula (+2.5%
// overheads on top) to these same inputs — see the Quote Wording skill —
// which differs from Prepare Price's own itemised repricing total.
model JobQuoteInputs {
  id               String   @id @default(cuid())
  jobNumber        String   @unique
  job              Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  supplierPrice    Float
  marginIsPercent  Boolean
  marginValue      Float
  installAllowance Float // installation + materials + rubbish removal + other, combined
  updatedById      String?
  updatedBy        User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt        DateTime @updatedAt
}

// A monthly snapshot of Residential/Commercial WIP so past month-ends can
// be looked back on even as the live Job/JobCosting data keeps changing.
// jobNumbers is the list of Job.number values included, for an audit trail.
model WipSnapshot {
  id                    String   @id @default(cuid())
  snapshotDate          DateTime // last day of the month being snapshotted
  residentialTotal      Float
  commercialTotal       Float
  jobNumbers            String[]
  xeroJournalId         String?
  xeroReversalJournalId String?
  createdAt             DateTime @default(now())

  @@index([snapshotDate])
}

// Real supplier/vendor contact book Jo supplied directly (not every one of
// these is a joinery supplier used on Site Measure emails — this is the
// broader Accounts-side directory of everyone Ali-Frame deals with).
model Supplier {
  id          String   @id @default(cuid())
  companyName String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyName])
}

// Named distribution groups for the Communications Hub (Management, Senior
// Installers, All Installers, Sales, Human Resources) — Jo manages who's in
// each herself; this is membership only, not a messaging/send feature yet.
model CommunicationGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  members   User[]   @relation("CommunicationGroupMembers")
  createdAt DateTime @default(now())
}

// Bookings against a job — Check Measure, Installation, Remedial or Sales
// Measure. Distinct from Calendar's due-date view: this is the actual
// per-job booking record with a specific date/time and assignee.
model JobScheduledTask {
  id            String      @id @default(cuid())
  jobNumber     String
  job           Job         @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  type          String // Check Measure / Installation / Remedial / Sales Measure
  scheduledDate DateTime
  // Multi-day bookings (e.g. a install running Mon-Fri) — null means a
  // single-day booking, same as scheduledDate.
  endDate       DateTime?
  // Time of day (24h "HH:MM"), optional — e.g. a check measure at 09:30.
  startTime     String?
  endTime       String?
  attachments   FileAsset[] @relation("BookingFiles")
  // A booking can be worked by more than one person (e.g. a 2-installer
  // team) — many-to-many, not a single assignee.
  assignees     User[]      @relation("JobScheduledTaskAssignees")
  notes         String?
  status        String      @default("Scheduled")
  createdById   String
  createdBy     User        @relation("JobScheduledTaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  completedAt   DateTime?

  @@index([jobNumber, scheduledDate])
}

// Staff leave / holidays — shows on the Calendar as an all-day bar, same as
// an install. Not job-scoped. Payroll-approved leave auto-pushing into this
// table (per Jo's 2026-09-26 request) is a later step, once there's a real
// payroll integration to push from — for now these are entered directly.
model StaffLeave {
  id          String    @id @default(cuid())
  type        String // Annual Leave / Sick Leave / Public Holiday / Bereavement Leave
  staff       User[]    @relation("StaffLeavePeople")
  fromDate    DateTime
  toDate      DateTime?
  notes       String?
  createdById String
  createdBy   User      @relation("StaffLeaveCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([fromDate])
}

// One-time "set your password" invite links. Only a SHA-256 hash of the
// token is stored; the raw token exists only in the emailed link.
model InviteToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserInvites", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---- Health & Safety (Ali-Frame's own system; structure only, no third-party content) ----

// Mirrors Ali-Frame's "Training and Competency Register". One row per person
// (staff or contractor). userId is optional so contractors who aren't app users can be listed.
model HsCompetency {
  id              String    @id @default(cuid())
  name            String
  userId          String?
  user            User?     @relation("UserCompetency", fields: [userId], references: [id], onDelete: SetNull)
  siteSafeNumber  String?
  keyRole         String?
  qualifications  String?
  expiryDate      DateTime?
  yearsExperience String?
  competency      Int? // 1-5
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([expiryDate])
}

// Company Hazard and Risk Register (initial vs residual risk, 4 levels: CRITICAL/HIGH/MEDIUM/LOW).
model HsRisk {
  id            String    @id @default(cuid())
  activity      String
  hazard        String
  potentialHarm String?
  initialRisk   String // CRITICAL | HIGH | MEDIUM | LOW
  controls      String
  residualRisk  String // CRITICAL | HIGH | MEDIUM | LOW
  ownerName     String?
  reviewDate    DateTime?
  status        String    @default("Open")
  createdAt     DateTime  @default(now())
}

model HsPreStart {
  id            String   @id @default(cuid())
  date          DateTime
  jobNumber     String?
  job           Job?     @relation("JobPreStarts", fields: [jobNumber], references: [number], onDelete: SetNull)
  completedById String
  completedBy   User     @relation("PreStartsCompleted", fields: [completedById], references: [id], onDelete: Cascade)
  crewNames     String?
  checks        Json // { "<check label>": "Pass" | "Fail" | "N/A" }
  issues        String?
  siteAddress   String?
  startTime     String?
  weather       Json? // ["Fine", "Light wind", ...]
  hazards       Json? // [{ hazard, risk, control }]
  workNotes     String?
  crewSignOn    Json? // [{ name, userId? }]
  stopWork      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([date])
}

model HsJsa {
  id           String   @id @default(cuid())
  jobNumber    String
  job          Job      @relation("JobJsas", fields: [jobNumber], references: [number], onDelete: Cascade)
  task         String
  steps        Json // [{ step, hazard, risk, control }]
  preparedById String
  preparedBy   User     @relation("JsasPrepared", fields: [preparedById], references: [id], onDelete: Cascade)
  status       String   @default("Draft")
  createdAt    DateTime @default(now())

  @@index([jobNumber])
}

// Site Specific Safety Plan — one per job. Fixed company content (policy, procedures, PPE,
// emergency plan, training register) is assembled at print time from HsDocument / HsCompetency / HsRisk.
model HsSssp {
  id                  String         @id @default(cuid())
  jobNumber           String         @unique
  job                 Job            @relation("JobSssp", fields: [jobNumber], references: [number], onDelete: Cascade)
  siteAddress         String?
  siteActivities      String?
  mainContractor      String?
  pcbu1ProjectManager String?
  pcbu1SiteManager    String?
  pcbu1HsRep          String?
  pcbu2ProjectManager String?
  pcbu2SiteManager    String?
  pcbu2HsRep          String?
  pcbu1SignedBy       String?
  pcbu1SignedAt       DateTime?
  pcbu2SignedBy       String?
  pcbu2SignedAt       DateTime?
  approvedToStartBy   String?
  approvedToStartAt   DateTime?
  siteNotes           String?
  status              String         @default("Draft")
  updatedById         String?
  updatedAt           DateTime       @updatedAt
  signOns             HsSsspSignOn[]
}

model HsSsspSignOn {
  id            String    @id @default(cuid())
  ssspId        String
  sssp          HsSssp    @relation(fields: [ssspId], references: [id], onDelete: Cascade)
  name          String
  company       String?
  inductionDate DateTime?
  recordedById  String?
  createdAt     DateTime  @default(now())

  @@index([ssspId])
}

model HsInduction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("Inductions", fields: [userId], references: [id], onDelete: Cascade)
  jobNumber  String?
  siteName   String?
  inductedBy String
  date       DateTime
  notes      String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Company H&S documents (policy, procedures, PPE, emergency plan...). Seeded from Ali-Frame's
// own signed Word documents; "approved" is only ever set by a named super user.
model HsDocument {
  slug           String    @id
  title          String
  sortOrder      Int       @default(0)
  version        String?
  status         String    @default("PENDING ORGANISATION REVIEW")
  effectiveDate  DateTime?
  nextReviewDate DateTime?
  content        String
  updatedByName  String?
  updatedAt      DateTime  @updatedAt
}

// Unhandled server errors, recorded by src/instrumentation.ts and looked up by the digest shown on the error page.
model ErrorLog {
  id        String   @id @default(cuid())
  digest    String?
  path      String
  method    String?
  routeType String?
  errorName String?
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([digest])
  @@index([createdAt])
}

// Company-wide policy PDFs (Human Resources > Company Policies). Readable by every signed-in user; only super users add/replace/archive.
model CompanyPolicy {
  id           String   @id @default(cuid())
  title        String
  category     String
  fileName     String
  storageKey   String
  mimeType     String   @default("application/pdf")
  sizeBytes    Int
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, sortOrder])
}

// HR details for one person. Kept apart from User so personal and pay data stay isolated: shown and
// edited by super users only. Pay is never stored for management. IRD numbers, bank accounts and tax
// details are deliberately NOT held here — they stay in iPayroll.
model EmployeeDetail {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation("EmployeeDetail", fields: [userId], references: [id], onDelete: Cascade)
  preferredName String?
  personalEmail String?
  address       String?
  jobTitle      String?
  startDate     DateTime?
  finishDate    DateTime?
  hoursPerWeek  Float?
  isManagement  Boolean   @default(false)
  payRate       Float?
  payType       String? // "per hour" | "per annum"
  annualSalary  Float?
  inviteTo      String    @default("work") // which address invites/alerts go to: "work" | "personal"
  source        String?
  updatedAt     DateTime  @updatedAt
}

// 360 competency review. "Create new assessment" makes one of these plus a self and a manager ReviewResponse.
// Ratings are 1-5 (or null = not observed); templateKey points at a definition in src/lib/reviewTemplates.ts.
model Review360 {
  id               String           @id @default(cuid())
  employeeId       String
  employee         User             @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  assessorId       String?
  assessor         User?            @relation("ReviewAssessor", fields: [assessorId], references: [id], onDelete: SetNull)
  templateKey      String
  period           String
  currentLevel     String?
  levelSought      String?
  workLocation     String?
  hoursPattern     String?
  assessmentDate   DateTime?
  selfDueDate      DateTime?
  nextReviewDate   DateTime?
  status           String           @default("Self-assessment pending") // Self-assessment pending | Awaiting manager | Completed
  evidence         Json? // [{ job, work, period, outcome, comments }]  (manager)
  feedback360      Json? // { peer: {strengths, development}, directReport: {...}, client: {...} }
  quals            Json? // { <key>: { evidence, status, action } }
  outcome          Json? // manager outcome table, benefits and development plan
  employeeComments String?
  employeeAckAt    DateTime?
  managerAckAt     DateTime?
  completedAt      DateTime?
  lastReminderAt   DateTime?
  triggeredById    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  responses        ReviewResponse[]

  @@index([employeeId, createdAt])
}

model ReviewResponse {
  id            String    @id @default(cuid())
  reviewId      String
  review        Review360 @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  role          String // self | manager
  contributorId String?
  ratings       Json      @default("{}") // { <itemKey>: { r: 1-5 | null, c: "comment" } }
  sectionNotes  Json? // { <sectionKey>: "summary / development need" }
  feedback      Json? // development & feedback answers (self)
  status        String    @default("Pending") // Pending | Draft | Submitted
  submittedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([reviewId, role])
}

// Daily cashflow forecast (BLB Daily Cashflow Forecast workbook, edited every day): one row per dated payment/receipt.
// The running balance, daily summary, key dates and monthly totals are all calculated from these rows.
model CashflowEntry {
  id        String   @id @default(cuid())
  date      DateTime
  details   String
  debit     Float    @default(0) // money out, incl GST
  credit    Float    @default(0) // money in, incl GST
  category  String?
  notes     String?
  done      Boolean  @default(false) // has actually happened (seen on the bank)
  source    String   @default("manual") // "workbook-v6" for the imported forecast, "manual" for lines added in the app
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// Key/value store for the cashflow inputs (opening balance, limits) and the reference tables imported from the workbook.
model CashflowSetting {
  key   String @id
  value String
}

// Operations "Create Check Measure" pack (approved template, Tanya 26/09/2026): the typed-in/edited content for a job,
// from which the check-measure PDF is generated. One pack per job; see src/lib/checkMeasure.ts for the data shape.
model CheckMeasurePack {
  jobNumber   String   @id
  job         Job      @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Health & Safety "QA Reports": pick a job, add photos, label each photo and describe it. Output is a PDF report.
model QaReport {
  id          String    @id @default(cuid())
  jobNumber   String
  job         Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  title       String    @default("Installation QA Report")
  reportDate  DateTime
  description String    @default("") // overall summary / scope of what was inspected
  status      String    @default("Draft") // Draft | Final
  createdById String
  createdBy   User      @relation("QaReportCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  photos      QaReportPhoto[]

  @@index([jobNumber, reportDate])
}

model QaReportPhoto {
  id          String    @id @default(cuid())
  reportId    String
  report      QaReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileId      String
  file        FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  label       String    @default("") // every photo must be labelled
  description String    @default("") // description written underneath the photo
  sortOrder   Int       @default(0)

  @@index([reportId, sortOrder])
}

// Screenshots/images attached to a Note (so it's clear what needs changing). Bytes live in R2 under notes/.
// Backup home for note attachments when file storage (R2) is unreachable: the bytes live here, kept apart from NoteAttachment
// so listing notes never loads file contents. A NoteAttachment with storageKey "db:<id>" points at one of these.
model NoteFileBlob {
  id           String   @id @default(cuid())
  data         Bytes
  mimeType     String
  fileName     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())
}

model NoteAttachment {
  id         String   @id @default(cuid())
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([noteId])
}

// Accident / Incident & Near-Miss reports (the digitised paper Accident Report form). The answers are stored whole in `data`
// (keys from src/lib/incidentSpec.ts); the columns below are for listing/filtering. Contains health information (Privacy Act 2020):
// only H&S / management staff may read everyone's; field staff only their own.
model IncidentReport {
  id               String   @id @default(cuid())
  reference        String   @unique // INC-0001
  personName       String
  siteName         String
  outcome          String
  notifiable       Boolean  @default(false)
  accidentDate     DateTime
  status           String   @default("Open") // Open | Closed
  data             Json
  signature        String?  @db.Text // PNG data URL of the signature
  submittedById    String
  submittedBy      User     @relation("IncidentReportSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedAt      DateTime @default(now())
  safetyIncidentId String?

  @@index([status, submittedAt])
}

// Aliframe QA check sheets under Health & Safety → QA Reporting: "RESIDENTIAL" (17-item yes/no sheet) or "COMMERCIAL"
// (full QA per window/door item with senior-leader sign-off). `data` holds the answers (see src/lib/qaSheets.ts).
model QaCheckSheet {
  id          String    @id @default(cuid())
  kind        String // RESIDENTIAL | COMMERCIAL
  jobNumber   String
  job         Job       @relation(fields: [jobNumber], references: [number], onDelete: Cascade)
  status      String    @default("Draft") // Draft | Complete
  data        Json
  createdById String
  createdBy   User      @relation("QaCheckSheetCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([jobNumber, kind])
}
